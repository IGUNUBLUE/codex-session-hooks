{
  "description": "Reference only. Run install.py so paths, interpreter commands, backups, and existing-hook preservation are handled safely.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/absolute/path/to/codex-session-hooks/superpowers-bootstrap.py' --managed-by=codex-session-hooks",
            "commandWindows": "python \"C:\\absolute\\path\\to\\codex-session-hooks\\superpowers-bootstrap.py\" --managed-by=codex-session-hooks",
            "statusMessage": "Loading Superpowers context",
            "timeout": 15,
            "additionalContextLimit": 2500
          }
        ]
      },
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/absolute/path/to/codex-session-hooks/openspec-context.py' --managed-by=codex-session-hooks",
            "commandWindows": "python \"C:\\absolute\\path\\to\\codex-session-hooks\\openspec-context.py\" --managed-by=codex-session-hooks",
            "statusMessage": "Loading OpenSpec context",
            "timeout": 15,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
